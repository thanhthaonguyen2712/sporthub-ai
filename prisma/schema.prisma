generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// ===================== ENUMS =====================

enum Role {
  ADMIN
  OWNER
  STAFF
  WAREHOUSE_MANAGER  
  CUSTOMER
}

enum DayType {
  WEEKDAY  // Ngày thường
  WEEKEND  // Cuối tuần
  HOLIDAY  // Ngày lễ
}

enum BookingStatus {
  PENDING    // Chờ xác nhận
  CONFIRMED  // Đã xác nhận
  CANCELLED  // Đã hủy
  COMPLETED  // Hoàn thành
  NO_SHOW    // Khách không đến
}

enum PaymentStatus {
  UNPAID   // Chưa thanh toán
  DEPOSIT  // Đã đặt cọc
  PAID     // Đã thanh toán đủ
}

enum ServiceType {
  PRODUCT  // Sản phẩm (nước, đồ ăn...)
  RENTAL   // Cho thuê (vợt, giày...)
}

enum StocklogType {
  IMPORT  // Nhập kho
  EXPORT  // Xuất kho
  DAMAGE  // Hàng hỏng
  SOLD    // Đã bán
}

enum WalletStatus {
  ACTIVE  // Ví đang hoạt động
  LOCKED  // Ví bị khóa
}

enum TransactionType {
  DEPOSIT  // Nạp tiền vào ví
  PAYMENT  // Thanh toán đặt sân
  REFUND   // Hoàn tiền khi hủy
  WITHDRAW // Rút tiền về ngân hàng
}

enum MatchLevel {
  BEGINNER     // Người mới
  INTERMEDIATE // Trung bình
  PRO          // Chuyên nghiệp
}

enum MatchStatus {
  OPEN    // Đang tìm người
  CLOSED  // Đã đủ người
  EXPIRED // Đã hết hạn
}

enum AttendanceStatus {
  WORKING   // Đang làm việc
  COMPLETED // Đã hoàn thành ca
  ABSENT    // Vắng mặt
}

enum DiscountType {
  PERCENT      // Giảm theo %
  FIXED_AMOUNT // Giảm số tiền cố định
}

enum PaymentMethod {
  CASH     // Tiền mặt
  TRANSFER // Chuyển khoản
  QR       // Quét mã QR
  WALLET   // Ví điện tử SportHub
}

enum GuestBookingStatus {
  PENDING
  CONFIRMED
  PAID
  EXPIRED
  CANCELLED
}

enum StaffRole {
  STAFF
  WAREHOUSE_MANAGER
}

enum ShiftType {
  MORNING
  AFTERNOON
  EVENING
}

enum ShiftStatus {
  OPEN
  CLOSED
  VERIFIED
}
enum EnrollmentStatus {
  PENDING   // Chờ thanh toán
  ACTIVE    // Đang học
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}
enum MembershipTier {
  FREE
  SILVER
  GOLD
  PLATINUM
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
// ===================== MODELS =====================

// 1. NGƯỜI DÙNG - Dùng chung cho tất cả role
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String   @unique
  fullName     String   @map("full_name")
  password     String
  avatar       String?
  role         Role     @default(CUSTOMER)
  loyaltyPoint Int      @default(0) @map("loyalty_points")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedFacilities Facility[]        @relation("OwnerFacilities")
  bookings        Booking[]         @relation("CustomerBookings")
  invoices        Invoice[]         @relation("StaffInvoices")
  matchPosts      MatchPost[]       @relation("CreatorMatchPosts")
  attendances     StaffAttendance[]
  reviews         Review[]
  vouchers        Voucher[]         @relation("OwnerVouchers")
  wallet          Wallet?
  facilityStaff   FacilityStaff[]
  inventoryShifts InventoryShift[]
  bankAccounts    BankAccount[]
  staffBookings      Booking[]         @relation("StaffBookings")
  resetToken     String?   @map("reset_token")
  resetTokenExp  DateTime? @map("reset_token_exp")
  coachCourses    Course[]          @relation("CoachCourses")
  enrollments     CourseEnrollment[]
  membership      Membership?

  @@map("users")
}

// 2. CHẤM CÔNG NHÂN VIÊN
model StaffAttendance {
  id           Int              @id @default(autoincrement())
  date         DateTime         @db.Date
  checkInTime  DateTime?        @map("check_in") @db.Time
  checkOutTime DateTime?        @map("check_out") @db.Time
  totalHours   Decimal?         @map("total_hours") @db.Decimal(4, 2)
  status       AttendanceStatus @default(WORKING)
  staffId      Int              @map("staff_id")
  staff        User             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_attendance")
}

// 3. DANH MỤC MÔN THỂ THAO
model SportCategory {
  id      Int     @id @default(autoincrement())
  name    String
  slug    String  @unique
  iconUrl String? @map("icon_url")

  courts         Court[]
  matchPosts     MatchPost[]
  facilitySports FacilitySport[]

  @@map("sport_categories")
}

// 4. CƠ SỞ / CỤM SÂN
model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  description String?  @db.Text
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isActive    Boolean  @default(true) @map("is_active")
  ownerId     Int      @map("owner_id")
  owner       User     @relation("OwnerFacilities", fields: [ownerId], references: [id], onDelete: Cascade)

  courts          Court[]
  services        Service[]
  matchPosts      MatchPost[]
  facilitySports  FacilitySport[]
  reviews         Review[]
  facilityStaff   FacilityStaff[]
  inventoryShifts InventoryShift[]
  courses         Course[]

  @@map("facilities")
}

// 5. BẢNG TRUNG GIAN CƠ SỞ - MÔN THỂ THAO
model FacilitySport {
  facilityId      Int           @map("facility_id")
  facility        Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sportCategoryId Int           @map("sport_category_id")
  sportCategory   SportCategory @relation(fields: [sportCategoryId], references: [id], onDelete: Cascade)

  @@id([facilityId, sportCategoryId])
  @@map("facility_sports")
}

// 6. SÂN CON
model Court {
  id         Int           @id @default(autoincrement())
  name       String
  isActive   Boolean       @default(true) @map("is_active")
  facilityId Int           @map("facility_id")
  facility   Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  categoryId Int           @map("category_id")
  category   SportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pricingRules CourtPricingRule[]
  bookings     Booking[]
  guestBookings GuestBooking[]

  @@map("courts")
}

// 7. QUY TẮC GIÁ SÂN - Giờ vàng/thường/lễ
model CourtPricingRule {
  id           Int      @id @default(autoincrement())
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  pricePerHour Decimal  @map("price_per_hour") @db.Decimal(10, 2)
  dayType      DayType  @map("day_type")
  priority     Int      @default(0)
  courtId      Int      @map("court_id")
  court        Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_pricerule")
}

// 8. VÍ ĐIỆN TỬ
model Wallet {
  id        Int          @id @default(autoincrement())
  balance   Decimal      @default(0) @db.Decimal(12, 2)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  userId    Int          @unique @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  @@map("wallets")
}

// 9. LỊCH SỬ GIAO DỊCH VÍ
model WalletTransaction {
  id          Int             @id @default(autoincrement())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  walletId    Int             @map("wallet_id")
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallets_transactions")
}

// 10. DỊCH VỤ BÁN KÈM - F&B, cho thuê đồ
model Service {
  id            Int         @id @default(autoincrement())
  name          String
  type          ServiceType
  price         Decimal     @db.Decimal(10, 2)
  stockQuantity Int         @default(0) @map("stock_quantity")
  isActive      Boolean     @default(true) @map("is_active")
  imageUrl      String?     @map("image_url")
  facilityId    Int         @map("facility_id")
  facility      Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  stockLogs    StockLog[]
  invoiceItems InvoiceItem[]
  inventoryItems InventoryShiftItem[]
  @@map("services")
}

// 11. NHẬT KÝ KHO
model StockLog {
  id        Int          @id @default(autoincrement())
  type      StocklogType
  quantity  Int
  note      String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  serviceId Int          @map("service_id")
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("stock_log")
}

// 12. ĐẶT SÂN - Trung tâm của hệ thống
model Booking {
  id            Int           @id @default(autoincrement())
  bookingDate   DateTime      @map("booking_date") @db.Date
  startTime     DateTime      @map("start_time") @db.Time
  endTime       DateTime      @map("end_time") @db.Time
  totalPrice    Decimal       @map("total_price") @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  isWalkIn      Boolean       @default(false) @map("is_walk_in") // Đặt tại quầy
  walkInName    String?       @map("walk_in_name")   // Tên khách vãng lai
  walkInPhone   String?       @map("walk_in_phone")  // SĐT khách vãng lai
  createdByStaff Boolean      @default(false) @map("created_by_staff") // Nhân viên đặt hộ
  createdAt     DateTime      @default(now()) @map("created_at")
  customerId    Int?          @map("customer_id")   // null nếu khách vãng lai
  customer      User?         @relation("CustomerBookings", fields: [customerId], references: [id])
  staffId       Int?          @map("staff_id")      // Nhân viên đặt hộ
  staff         User?         @relation("StaffBookings", fields: [staffId], references: [id])
  courtId       Int           @map("court_id")
  court         Court         @relation(fields: [courtId], references: [id])
  voucherId     Int?          @map("voucher_id")
  voucher       Voucher?      @relation(fields: [voucherId], references: [id])
  invoice Invoice?

  @@map("booking")
}

// 13. HÓA ĐƠN - Tạo khi staff check-in cho khách
model Invoice {
  id             Int           @id @default(autoincrement())
  subTotal       Decimal       @map("sub_total") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalTotal     Decimal       @map("final_total") @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  createdAt      DateTime      @default(now()) @map("created_at")
  bookingId      Int           @unique @map("booking_id")
  booking        Booking       @relation(fields: [bookingId], references: [id])
  staffId        Int?          @map("staff_id")
  staff          User?         @relation("StaffInvoices", fields: [staffId], references: [id])

  items InvoiceItem[]

  @@map("invoices")
}

// 14. CHI TIẾT HÓA ĐƠN
model InvoiceItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  invoiceId Int      @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId Int?     @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id])

  @@map("invoice_items")
}

// 15. BÀI ĐĂNG TÌM ĐỐI - Tính năng "Cáp kèo"
model MatchPost {
  id              Int           @id @default(autoincrement())
  title           String
  description     String?       @db.Text
  matchDate       DateTime      @map("match_date") @db.Date
  startTime       DateTime      @map("start_time") @db.Time
  endTime         DateTime      @map("end_time") @db.Time
  level           MatchLevel
  status          MatchStatus   @default(OPEN)
  requiredPlayers Int           @default(1) @map("required_players")
  joinedPlayers   Int           @default(0) @map("joined_players")
  createdAt       DateTime      @default(now()) @map("created_at")
  creatorId       Int           @map("creator_id")
  creator         User          @relation("CreatorMatchPosts", fields: [creatorId], references: [id], onDelete: Cascade)
  facilityId      Int           @map("facility_id")
  facility        Facility      @relation(fields: [facilityId], references: [id])
  categoryId      Int           @map("category_id")
  category        SportCategory @relation(fields: [categoryId], references: [id])

  @@map("match_posts")
}

// 16. ĐÁNH GIÁ SÂN
model Review {
  id         Int      @id @default(autoincrement())
  rating     Int      @db.TinyInt
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  customerId Int      @map("customer_id")
  customer   User     @relation(fields: [customerId], references: [id])
  facilityId Int      @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// 17. VOUCHER / MÃ GIẢM GIÁ
model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0) @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(10, 2)
  startDate     DateTime     @map("start_date") @db.DateTime(0)
  endDate       DateTime     @map("end_date") @db.DateTime(0)
  usageLimit    Int          @default(1) @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  isActive      Boolean      @default(true) @map("is_active")
  ownerId       Int          @map("owner_id")
  owner         User         @relation("OwnerVouchers", fields: [ownerId], references: [id])

  bookings Booking[]

  @@map("vouchers")
}
// 18. NHÂN VIÊN THUỘC CƠ SỞ CỤ THỂ
model FacilityStaff {
  id         Int       @id @default(autoincrement())
  facilityId Int       @map("facility_id")
  userId     Int       @map("user_id")
  role       StaffRole @default(STAFF)
  createdAt  DateTime  @default(now()) @map("created_at")

  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([facilityId, userId])
  @@map("facility_staff")
}

// 19. KHÁCH VÃNG LAI ĐẶT SÂN
model GuestBooking {
  id          Int                @id @default(autoincrement())
  guestName   String             @map("guest_name")
  guestPhone  String             @map("guest_phone")
  guestEmail  String?            @map("guest_email")
  courtId     Int                @map("court_id")
  bookingDate DateTime           @map("booking_date") @db.Date
  startTime   DateTime           @map("start_time") @db.Time
  endTime     DateTime           @map("end_time") @db.Time
  totalPrice  Decimal            @map("total_price") @db.Decimal(10, 2)
  status      GuestBookingStatus @default(PENDING)
  otpCode     String?            @map("otp_code")
  otpExpiry   DateTime?          @map("otp_expiry")
  expiredAt   DateTime           @map("expired_at")
  paymentQr   String?            @map("payment_qr") @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")

  court       Court              @relation(fields: [courtId], references: [id])

  @@map("guest_bookings")
}

// 20. CA KIỂM KÊ KHO
model InventoryShift {
  id         Int         @id @default(autoincrement())
  facilityId Int         @map("facility_id")
  managerId  Int         @map("manager_id")
  shiftDate  DateTime    @map("shift_date") @db.Date
  shiftType  ShiftType   @map("shift_type")
  notes      String?     @db.Text
  status     ShiftStatus @default(OPEN)
  createdAt  DateTime    @default(now()) @map("created_at")
  closedAt   DateTime?   @map("closed_at")

  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  manager    User        @relation(fields: [managerId], references: [id])
  items      InventoryShiftItem[]

  @@map("inventory_shifts")
}

// 21. CHI TIẾT KIỂM KÊ KHO THEO CA
model InventoryShiftItem {
  id             Int      @id @default(autoincrement())
  shiftId        Int      @map("shift_id")
  serviceId      Int      @map("service_id")
  openingStock   Int      @map("opening_stock")
  sold           Int      @default(0)
  returned       Int      @default(0)
  closingStock   Int?     @map("closing_stock")
  discrepancy    Int?
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  shift          InventoryShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id])

  @@map("inventory_shift_items")
}
// 22. TÀI KHOẢN NGÂN HÀNG
model BankAccount {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}
// 23. KHÓA HỌC
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  sport       String   // Môn thể thao
  level       MatchLevel
  price       Decimal  @db.Decimal(10, 2)
  maxStudents Int      @default(10) @map("max_students")
  schedule    String   // "T2, T4, T6 - 07:00"
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isPublic    Boolean  @default(true) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")
  facilityId  Int?     @map("facility_id")
  courtId     Int?     @map("court_id")
  coachId     Int      @map("coach_id")
  createdAt   DateTime @default(now()) @map("created_at")

  coach       User              @relation("CoachCourses", fields: [coachId], references: [id])
  facility    Facility?         @relation(fields: [facilityId], references: [id])
  enrollments CourseEnrollment[]

  @@map("courses")
}

// 24. ĐĂNG KÝ KHÓA HỌC
model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  userId    Int      @map("user_id")
  status    EnrollmentStatus @default(PENDING)
  progress  Int      @default(0) // % tiến độ
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_enrollments")
}

// 25. GÓI HỘI VIÊN
model Membership {
  id        Int              @id @default(autoincrement())
  userId    Int              @unique @map("user_id")
  tier      MembershipTier   @default(FREE)
  status    MembershipStatus @default(ACTIVE)
  startDate DateTime?        @map("start_date")
  endDate   DateTime?        @map("end_date")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}